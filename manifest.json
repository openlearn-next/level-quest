{
  "id": "@openlearn-community/level-quest",
  "name": "课堂闯关",
  "version": "0.2.1",
  "main": "index.js",
  "icon": "Swords",
  "executionMode": "process",
  "description": "在课程编辑器中添加「课堂闯关」教学形态并配置关卡与解锁条件：学生完成当前关卡（或等待教师放行）后才能进入下一关。支持选择题/判断题/文本题自动判定、手动完成与作业提交，教师端提供实时看板、放行与重置。",
  "author": "OpenLearn Community",
  "engines": {
    "openlearn": ">=0.7.6"
  },
  "capabilitiesProposed": [
    "lesson:read",
    "lesson:write"
  ],
  "contributes": {
    "teacher.tab": [
      {
        "id": "lvq-tab",
        "label": "课堂闯关",
        "icon": "Swords",
        "position": 46,
        "view": "storage/teacher.html"
      }
    ],
    "editor.timeline_segment": [
      {
        "id": "level-quest",
        "title": "课堂闯关",
        "labelZh": "课堂闯关",
        "labelEn": "Level Quest",
        "icon": "Swords",
        "view": "storage/quest-editor.html"
      }
    ]
  },
  "api": {
    "routes": [
      {
        "method": "GET",
        "path": "/overview",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      },
      {
        "method": "POST",
        "path": "/levels",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 1200
        }
      },
      {
        "method": "POST",
        "path": "/start",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 600
        }
      },
      {
        "method": "POST",
        "path": "/end",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 600
        }
      },
      {
        "method": "GET",
        "path": "/dashboard",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 12000
        }
      },
      {
        "method": "GET",
        "path": "/attempts",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 6000
        }
      },
      {
        "method": "POST",
        "path": "/release",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 6000
        }
      },
      {
        "method": "POST",
        "path": "/unlock",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 6000
        }
      },
      {
        "method": "POST",
        "path": "/request-unlock",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 1200
        }
      },
      {
        "method": "POST",
        "path": "/reset",
        "roles": [
          "teacher"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      },
      {
        "method": "GET",
        "path": "/state",
        "roles": [
          "teacher",
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 20000
        }
      },
      {
        "method": "POST",
        "path": "/answer",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 6000
        }
      },
      {
        "method": "POST",
        "path": "/self-report",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      },
      {
        "method": "POST",
        "path": "/submission",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      },
      {
        "method": "POST",
        "path": "/upload/init",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      },
      {
        "method": "POST",
        "path": "/upload/chunk",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 20000
        }
      },
      {
        "method": "POST",
        "path": "/upload/finish",
        "roles": [
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      },
      {
        "method": "GET",
        "path": "/file/:id",
        "roles": [
          "teacher",
          "student"
        ],
        "rateLimit": {
          "windowMs": 60000,
          "max": 3000
        }
      }
    ]
  }
}
