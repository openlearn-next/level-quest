{
  "name": "openlearn-plugin-level-quest",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "课堂闯关 —— 学生完成当前关卡任务后才能解锁下一关（OpenLearnV2 第三方插件）",
  "author": "OpenLearn Community",
  "scripts": {
    "build": "openlearn-plugin-sdk build",
    "dev": "openlearn-plugin-sdk build --watch",
    "test:contract": "node test-harness/static-check.mjs . && node scripts/check-reserved-routes.mjs .",
    "pack": "node scripts/pack.mjs",
    "release": "npm run build && npm run test:contract && npm run pack"
  },
  "dependencies": {
    "@openlearn/plugin-sdk": "^3.7.4"
  },
  "devDependencies": {
    "jszip": "^3.10.1",
    "typescript": "~5.8.0"
  }
}
